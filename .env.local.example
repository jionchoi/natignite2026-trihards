# Get a free key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# Optional: hosted depth model via Replicate (keeps the client light for mobile).
# Get a token at https://replicate.com/account/api-tokens
# If unset, the app falls back to the local in-browser depth model automatically.
REPLICATE_API_TOKEN=your_replicate_token_here
# Optional override (defaults to chenxwh/depth-anything-v2)
# REPLICATE_DEPTH_MODEL=chenxwh/depth-anything-v2
